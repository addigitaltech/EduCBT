# EduCBT - central platform environment. Safe example values only.
# For a central deployment copy .env.central.example instead.
APP_NAME="EduCBT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=0.1.0-phase1
# Stored dates are UTC; this is the time zone people see.
APP_DISPLAY_TIMEZONE=Africa/Lagos

# Which application profile this deployment runs: "school" or "central".
# A deployment is installed as ONE profile and must never be switched.
APP_PROFILE=central

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For MariaDB/MySQL use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=educbt_central
# DB_USERNAME=educbt
# DB_PASSWORD=change-me

# Authentication model (identity domain)
AUTH_MODEL=App\Domain\Identity\Models\User

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Run the queue worker through the scheduler (needed on cPanel / shared hosting).
# Set to false if you run a dedicated worker (systemd/supervisor).
QUEUE_VIA_SCHEDULER=true

MAIL_MAILER=log
BCRYPT_ROUNDS=12

# Central deployment notes:
# - cPanel/shared hosting: add one cron entry, every minute:
#   * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
# - Set APP_ENV=production, APP_DEBUG=false and SESSION_SECURE_COOKIE=true behind HTTPS.
