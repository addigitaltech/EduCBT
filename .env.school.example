# EduCBT - school server environment. Safe example values only.
# For a central deployment copy .env.central.example instead.
APP_NAME="EduCBT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_VERSION=0.1.0-phase1
# Stored dates are UTC; this is the time zone people see.
APP_DISPLAY_TIMEZONE=Africa/Lagos

# Which application profile this deployment runs: "school" or "central".
# A deployment is installed as ONE profile and must never be switched.
APP_PROFILE=school

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For MariaDB/MySQL use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=educbt_school
# DB_USERNAME=educbt
# DB_PASSWORD=change-me

# Authentication model (identity domain)
AUTH_MODEL=App\Domain\Identity\Models\User

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Run the queue worker through the scheduler (needed on cPanel / shared hosting).
# Set to false if you run a dedicated worker (systemd/supervisor).
QUEUE_VIA_SCHEDULER=true

MAIL_MAILER=log
BCRYPT_ROUNDS=12

# School server notes:
# - Prefer a dedicated worker (systemd/supervisor) and set QUEUE_VIA_SCHEDULER=false.
# - Use a UPS so confirmed saves survive power cuts.
# - Set APP_ENV=production and APP_DEBUG=false on the live server.
